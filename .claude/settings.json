{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": false
  },
  "permissions": {
    "deny": [
      "Bash(npx wrangler auth token*)",
      "Bash(wrangler auth token*)",
      "Bash(pnpm exec wrangler auth token*)",
      "Bash(bunx wrangler auth token*)",
      "Bash(cf auth token*)",
      "Bash(gh auth token*)",
      "Bash(git credential*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth status *--show-token*)",
      "Bash(gh auth status *-t*)",
      "Bash(gh auth refresh*)",
      "Bash(gh auth status --show-token*)",
      "Bash(gh auth status -t*)",
      "Bash(wrangler secret*)",
      "Bash(npx wrangler secret*)",
      "Bash(wrangler delete*)",
      "Bash(npx wrangler delete*)",
      "Bash(npx wrangler d1 delete*)",
      "Bash(npx wrangler kv namespace delete*)",
      "Bash(npx wrangler r2 bucket delete*)",
      "Bash(npx wrangler d1 execute * --remote*)",
      "Bash(cf * delete*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --delete*)",
      "Bash(git branch -D*)",
      "Bash(gh repo delete*)",
      "Read(~/.config/.wrangler/**)",
      "Read(~/.config/cf/**)",
      "Read(~/.alchemy/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/wheelhouse/config.json)"
    ]
  }
}
